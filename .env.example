SECRET_KEY=replace-this-with-a-secure-django-secret-key
DEBUG=True
DB_NAME=sportspot_db
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
FRONTEND_URL=http://localhost:3000

KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_WEBSITE_URL=http://localhost:3000
KHALTI_RETURN_PATH=/dashboard/player/bookings/payment/khalti-return

# Development default: emails are printed in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_sender_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=SportSpot <no-reply@example.com>
SPORTSPOT_SUPPORT_EMAIL=support@example.com

# Local development may show clearer account-recovery messages.
# Production security: set this to False to avoid account-email enumeration.
ACCOUNT_RECOVERY_REVEAL_EMAIL_ERRORS=True
