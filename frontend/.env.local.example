NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Map tiles used by the venue location picker and public venue map.
# The default OpenStreetMap URL is suitable for local, low-volume development.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# When opening the frontend from another device, use the computer's LAN API address.
# Example: NEXT_PUBLIC_API_URL=http://192.168.1.10:8000
